# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (agentes de IA) ---
ANTHROPIC_API_KEY=

# --- Kiwify ---
# Token do webhook (Kiwify > Apps > Webhooks). Usado para validar a assinatura.
KIWIFY_WEBHOOK_TOKEN=

# --- Z-API (WhatsApp) ---
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Segredo que vai na URL do webhook configurado na Z-API: /api/webhooks/zapi?secret=...
ZAPI_WEBHOOK_SECRET=
# Telefone ou ID do grupo que recebe o relatório diário (opcional)
RELATORIO_WHATSAPP_DESTINO=

# --- Evolution API (WhatsApp dos agentes comerciais; uma instância por projeto) ---
EVOLUTION_URL=
EVOLUTION_API_KEY=
# Segredo na URL do webhook: /api/webhooks/evolution?secret=...
EVOLUTION_WEBHOOK_SECRET=
# Bearer que o agendador do Supabase (pg_cron) usa em /api/cron/comercial (o mesmo valor vai no Vault)
COMERCIAL_CRON_SECRET=

# --- Meta Ads ---
# Token de usuário do sistema do Business Manager com permissão ads_read (e ads_management nas próximas fases)
META_ACCESS_TOKEN=
META_API_VERSION=v23.0

# --- Vercel Cron ---
CRON_SECRET=
